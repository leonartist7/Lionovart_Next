# ── Required at runtime (src/lib/env.ts throws if missing) ──────────────
WHATSAPP_NUMBER=15878974772
BOOKING_URL=https://calendar.app.google/your-booking-link

# ── Gemini (voice agent + text chat + summaries + dossier) ──────────────
GEMINI_API_KEY=
# Live voice model (WS proxy). Hot-swappable via Firestore agent_config/live.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# Text-chat fallback model
GEMINI_MODEL=gemini-2.5-flash
# Post-call lead dossier generation model (deeper reasoning than the live/chat models)
GEMINI_DOSSIER_MODEL=gemini-3.1-pro

# ── NOVA WS security ────────────────────────────────────────────────────
# HMAC secret for short-lived WS session tokens (/api/strategist/session-token).
# Unset = proxy allows unauthenticated WS connections (dev only — set in prod).
NOVA_WS_SECRET=
# Global concurrent voice-session cap per server instance (default 20)
NOVA_WS_MAX_GLOBAL=20

# ── Firebase Admin (leads / conversations / agent config; degrades gracefully) ──
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── NOVA Console (/admin) ────────────────────────────────────────────────
# Comma-separated allowlist of Google account emails granted console access.
# Default when unset: leonartist.cs@gmail.com
NOVA_ADMIN_EMAILS=leonartist.cs@gmail.com

# ── Firebase client SDK (public) ────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional integrations ───────────────────────────────────────────────
RESEND_API_KEY=
SLACK_WEBHOOK_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# GMB/Places lookup for lead enrichment (Phase 5.1) — no-ops gracefully if unset
GOOGLE_PLACES_API_KEY=

# ── Cal.com real booking (Phase 4.1) ─────────────────────────────────────
# Both required for real booking; Console "Booking mode" also gates this —
# defaults to "link" (current BOOKING_URL handoff) even if these are set.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ── Sanity (draft mode; barely wired) ───────────────────────────────────
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
